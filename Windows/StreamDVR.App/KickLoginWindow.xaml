<Window x:Class="StreamDVR.App.KickLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Kick" Height="620" Width="500"
        WindowStartupLocation="CenterOwner" Background="#F2F0F7">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="12,10" FontSize="13" Foreground="Gray" TextWrapping="Wrap"
                   Text="Optional — Kick streams record fine without logging in. Sign in below, then click ✓ Save session (or close the window)." />

        <wv2:WebView2 x:Name="WebView" Grid.Row="1" Margin="0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
            <TextBlock x:Name="HintText" Text="Waiting for login..." Foreground="Gray" Margin="0,0,12,0"
                       VerticalAlignment="Center" />
            <Button x:Name="SaveButton" Content="✓ Save session" Padding="12,6" Click="OnSave"
                    Style="{StaticResource AccentSolidButton}" />
            <Button Content="Close" Margin="8,0,0,0" Padding="12,6" Click="OnClose"
                    Style="{StaticResource SmallButton}" />
        </StackPanel>
    </Grid>
</Window>