<Window x:Class="TwitchDVR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TwitchDVR.App"
        Title="StreamDVR" Height="640" Width="960"
        MinHeight="480" MinWidth="720"
        Background="#F2F0F7"
        Icon="pack://application:,,,/app.ico"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <local:SuccessGreenConverter x:Key="SuccessGreenConverter" />
        <local:LogForegroundConverter x:Key="LogForegroundConverter" />
    </Window.Resources>

    <DockPanel>

        <!-- ===== Header ===== -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E0D9F0" BorderThickness="0,0,0,1" Padding="14,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                    Stream<Run Foreground="{StaticResource AccentBrush}" FontWeight="Bold">DVR</Run>
                </TextBlock>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LoginButton" Click="OnLoginToggle" Padding="12,6" Margin="0,0,8,0"
                            Style="{StaticResource AccentButton}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,6">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MonitorButton" Click="OnMonitorToggle" Margin="0,0,12,0" Padding="12,6"
                            Style="{StaticResource AccentButton}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,6">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="StateText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="Gray" FontSize="12" />
            </DockPanel>
        </Border>

        <!-- ===== Status Bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E0D9F0" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock FontSize="11" Foreground="Gray" VerticalAlignment="Center">
                    <Run Text="{Binding Channels.Count, Mode=OneWay}" /><Run Text=" channels  |  " />
                    <Run Text="{Binding OnlineCount, Mode=OneWay}" Foreground="#2EA043" /><Run Text=" live  |  " />
                    <Run Text="{Binding OfflineCount, Mode=OneWay}" /><Run Text=" offline  |  " />
                    <Run Text="{Binding RecordingCount, Mode=OneWay}" Foreground="Red" /><Run Text=" recording" />
                </TextBlock>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Click="OnCheckForUpdate" Padding="8,3" Margin="6,0,0,0"
                            Style="{StaticResource SmallButton}" Cursor="Hand"
                            ToolTip="Download and install the new version"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisConverter}}">
                        <TextBlock FontSize="11">
                            <Run Text="⬆ Update v" /><Run Text="{Binding PendingUpdate.Version, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                    </Button>
                    <TextBlock x:Name="UpdateStatusText" FontSize="11" Foreground="Gray"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="For personal use · Created by Kamil Gorecki"
                   Foreground="Gray" FontSize="11" HorizontalAlignment="Center" Margin="0,4" />

        <!-- ===== Tabs ===== -->
        <TabControl DockPanel.Dock="Top" Margin="12,8,12,0" Background="Transparent"
                    x:Name="TabControl" SelectionChanged="OnTabChanged">
            <TabItem Header="Channels">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Add channel bar with platform picker -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="PlatformPicker" Width="120" Padding="4" VerticalContentAlignment="Center"
                                  Margin="0,0,8,0" SelectedIndex="0"
                                  ToolTip="Platform for plain channel names (URLs auto-detect platform)">
                            <ComboBoxItem Content="Twitch" Tag="twitch" />
                            <ComboBoxItem Content="Chaturbate" Tag="chaturbate" />
                            <ComboBoxItem Content="Kick" Tag="kick" />
                        </ComboBox>
                        <TextBox x:Name="ChannelInput" Width="320" Padding="4" VerticalContentAlignment="Center"
                                 KeyDown="OnChannelInputKeyDown"
                                 ToolTip="Enter channel name or URL: twitch.tv/shroud, kick.com/odablock, chaturbate.com/sweetsweet__baby" />
                        <Button x:Name="AddButton" Content="+  Channel" Margin="8,0,0,0" Padding="10,4"
                                Style="{StaticResource AccentSolidButton}" Click="OnAddChannel" />
                        <Button Content="Stop All" Margin="8,0,0,0" Padding="10,4"
                                Style="{StaticResource SmallButton}" Foreground="#C00000"
                                Click="OnStopAll"
                                Visibility="{Binding HasActiveRecordings, Converter={StaticResource BoolVisConverter}}"
                                ToolTip="Stop all active recordings" />
                    </StackPanel>

                    <!-- Auto-sort toggle -->
                    <CheckBox Grid.Row="1" Content="Auto sort — live channels to top" Margin="0,0,0,6"
                              IsChecked="{Binding AutoSortLive}" FontSize="11" Foreground="Gray"
                              ToolTip="Automatically move live channels to the top of the list" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChannelsList" ItemsSource="{Binding Channels}"
                                      AllowDrop="True" Drop="OnChannelsDrop" DragOver="OnChannelsDragOver">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="10,8" Background="#FFFFFF"
                                            BorderBrush="#E4DDF0" BorderThickness="1" CornerRadius="6"
                                            MouseLeftButtonDown="OnChannelMouseDown"
                                            MouseMove="OnChannelMouseMove">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" ToolTip="{Binding Channel.DisplayName}">
                                                <Ellipse Fill="#E6DFF6" />
                                                <TextBlock Text="{Binding Channel.DisplayName, Converter={StaticResource InitialConverter}}"
                                                           Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Channel.ProfileImageUrl, Converter={StaticResource EmptyToImageSourceConverter}}"
                                                                    Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Channel.DisplayName}" FontWeight="Bold" FontSize="14"
                                                           Cursor="Hand" MouseLeftButtonDown="OnOpenChannelName" />
                                                    <Border Margin="6,0,0,0" CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                                            Background="{Binding Channel.Platform, Converter={StaticResource PlatformColorConverter}}">
                                                        <TextBlock Text="{Binding Channel.Platform, Converter={StaticResource PlatformNameConverter}}"
                                                                   FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Channel.CurrentStreamTitle}" FontSize="12"
                                                           Foreground="Gray" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Channel.CurrentStreamTitle}" />
                                                <TextBlock Text="{Binding Channel.CurrentGame}" FontSize="11"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center"
                                                        Margin="12,0" MinWidth="180">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolRedConverter}}" />
                                                <TextBlock Text="{Binding StatsText}" FontSize="10" Foreground="Gray" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ToggleButton x:Name="RecordToggle" IsChecked="{Binding IsActive}"
                                                              Width="60" Content="Record"
                                                              Style="{StaticResource RecordToggleStyle}"
                                                              Click="OnRecordToggle" />
                                                <Button Content="📁" Margin="6,0,0,0" Padding="6,2"
                                                        Style="{StaticResource SmallButton}"
                                                        Click="OnOpenChannelFolder"
                                                        ToolTip="Open recording folder" />
                                                <Button Content="✕" Margin="6,0,0,0" Padding="6,2"
                                                        Style="{StaticResource SmallButton}"
                                                        Click="OnRemoveChannel"
                                                        ToolTip="Remove channel" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== Recordings ===== -->
            <TabItem Header="Recordings">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Recordings folder: " VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OutputDirectory}" VerticalAlignment="Center" Foreground="Gray" />
                        <Button Content="Open Folder" Margin="12,0,0,0" Padding="10,4"
                                Style="{StaticResource AccentSolidButton}" Click="OnOpenFolder" />
                        <Button Content="Refresh" Margin="8,0,0,0" Padding="10,4"
                                Style="{StaticResource SmallButton}" Click="OnRefreshRecordings" />
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="RecordingsList" ItemsSource="{Binding Recordings}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="📂" Margin="4,0,0,0" Padding="4,2"
                                            Style="{StaticResource SmallButton}" Click="OnRevealRecording"
                                            ToolTip="Reveal in Explorer" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="Gray"
                                               Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ===== Logs ===== -->
            <TabItem Header="Logs">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Activity Log" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Clear" HorizontalAlignment="Right" Padding="10,4"
                                Style="{StaticResource SmallButton}" Click="OnClearLogs" />
                    </DockPanel>
                    <ListBox Grid.Row="1" x:Name="LogsList" ItemsSource="{Binding Logs}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="64" Foreground="Gray" />
                                    <TextBlock Text="{Binding Icon}" Width="20" Foreground="{Binding Foreground}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Foreground}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="560">
                        <GroupBox Header="Account (Twitch)" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="AccountText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button x:Name="SignInButton" Content="Sign in with Twitch" Padding="12,6" Width="200"
                                        HorizontalAlignment="Left" Style="{StaticResource AccentSolidButton}"
                                        Click="OnSignIn" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Account (Kick)" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="KickAccountText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button x:Name="KickSignInButton" Padding="12,6" Width="200"
                                        HorizontalAlignment="Left" Style="{StaticResource AccentSolidButton}"
                                        Background="#2EA043" Click="OnKickSignIn" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Recording Settings" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Output folder:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding OutputDirectory, Mode=TwoWay}" Foreground="Gray" TextWrapping="Wrap"
                                           Margin="0,2,0,6" />
                                <Button Content="Choose Folder..." Padding="12,6" HorizontalAlignment="Left"
                                        Style="{StaticResource AccentSolidButton}" Click="OnChooseFolder" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Channel List" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Auto sort — live channels to top"
                                          IsChecked="{Binding AutoSortLive}"
                                          ToolTip="Move live channels to the top of the list" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="System" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Keep Windows awake while monitoring"
                                          IsChecked="{Binding PreventSleep}"
                                          ToolTip="Prevents the system from going to sleep during active recording (uses Windows power assertion)" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Updates" Padding="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Check now" Padding="10,4"
                                            Style="{StaticResource SmallButton}" Click="OnCheckForUpdate" />
                                    <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="Gray" FontSize="12" />
                                </StackPanel>
                                <Button x:Name="DownloadUpdateButton" Content="Download &amp; Restart" Padding="10,4"
                                        Style="{StaticResource AccentSolidButton}" Click="OnDownloadUpdate"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisConverter}}"
                                        Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
